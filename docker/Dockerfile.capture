# syntax=docker/dockerfile:1
#
# Browser capture image (spec §6.2/§6.3).
#
# Pinned by digest; rootless-compatible UID 1000; no capabilities required.
# Chromium runs with the network namespace disabled: pages are served by the
# local file/http layer inside the container, frames go to the mounted store.
ARG DEBIAN_IMAGE=debian:bookworm-slim@sha256:7ff6ba31527b9e336162fa061746c366c4b2032f4d2cff2078bea43f78efe3f8
FROM ${DEBIAN_IMAGE}

ARG SOURCE_DATE_EPOCH=1700000000
ARG DEBIAN_SNAPSHOT=20261101T082805Z
ENV SOURCE_DATE_EPOCH=${SOURCE_DATE_EPOCH} \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DEBIAN_FRONTEND=noninteractive

RUN set -eux; \
    rm -f /etc/apt/sources.list; \
    rm -rf /etc/apt/sources.list.d; \
    mkdir -p /etc/apt/sources.list.d; \
    printf '%s\n' \
      "deb http://snapshot.debian.org/archive/debian/${DEBIAN_SNAPSHOT} bookworm main" \
      "deb http://snapshot.debian.org/archive/debian/${DEBIAN_SNAPSHOT} bookworm-updates main" \
      "deb http://snapshot.debian.org/archive/debian-security/${DEBIAN_SNAPSHOT} bookworm-security main" \
      > /etc/apt/sources.list; \
    printf 'Acquire::Check-Valid-Until "false";\n' > /etc/apt/apt.conf.d/99no-check-valid-until; \
    apt-get update; \
    apt-get install --no-install-recommends -y \
        chromium=150.0.7871.100-1~deb12u1 \
        fonts-dejavu-core=2.37-6 \
        python3=3.11.2-1+b1; \
    rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/*

RUN groupadd --gid 1000 sandbox \
    && useradd --uid 1000 --gid 1000 --create-home --shell /usr/sbin/nologin sandbox \
    && install -d -o 1000 -g 1000 -m 0755 /workspace /out

WORKDIR /workspace
USER 1000:1000

# --no-sandbox is deliberately *not* used: under runsc the user namespace is
# available.  /dev/shm is a 64 MiB tmpfs but chromium still wants more, so
# dev-shm usage is disabled.
CMD ["chromium", "--headless=new", "--disable-dev-shm-usage", \
     "--disable-gpu", "--no-first-run", "--hide-scrollbars", \
     "--remote-debugging-address=127.0.0.1", "--remote-debugging-port=9222", \
     "about:blank"]
