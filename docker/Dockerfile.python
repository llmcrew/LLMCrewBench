# syntax=docker/dockerfile:1
#
# Runner image for Python tasks (spec §6.2/§6.3).
#
# The base is pinned by digest: `latest` is forbidden, and a tag-only base is
# only accepted for an explicit local rebuild.  Build through
# `scripts/sandbox_run.py build`, which passes PYTHON_IMAGE.
#
# Rootless-compatible: the process runs as UID/GID 1000, needs no capabilities,
# no writable rootfs, and no init privileges.  Everything the candidate may
# write lives on the tmpfs mounts at /tmp and /dev/shm, or on the per-run write
# directory mounted at /out.
ARG PYTHON_IMAGE=python:3.12-slim@sha256:2259debdc6af85626058a15a7bf44ad6a68b8c98c9ae82a02cf5cdb92f096d47
FROM ${PYTHON_IMAGE}

ARG SOURCE_DATE_EPOCH=1700000000
ARG DEBIAN_SNAPSHOT=20261101T082805Z
ENV SOURCE_DATE_EPOCH=${SOURCE_DATE_EPOCH} \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONHASHSEED=0 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1

# База уже по digest. Пакетов apt здесь нет; sources заморожены тем же снимком,
# что и остальные образы, чтобы поздний apt-get не уехал с build-date.
RUN set -eux; \
    rm -f /etc/apt/sources.list; \
    rm -rf /etc/apt/sources.list.d; \
    mkdir -p /etc/apt/sources.list.d; \
    printf '%s\n' \
      "deb http://snapshot.debian.org/archive/debian/${DEBIAN_SNAPSHOT} trixie main" \
      "deb http://snapshot.debian.org/archive/debian/${DEBIAN_SNAPSHOT} trixie-updates main" \
      "deb http://snapshot.debian.org/archive/debian-security/${DEBIAN_SNAPSHOT} trixie-security main" \
      > /etc/apt/sources.list; \
    printf 'Acquire::Check-Valid-Until "false";\n' > /etc/apt/apt.conf.d/99no-check-valid-until

# Stable, unprivileged identity.  `--create-home` is needed because pip and
# some task fixtures expect $HOME; /workspace and /out are mount points.
RUN groupadd --gid 1000 sandbox \
    && useradd --uid 1000 --gid 1000 --create-home --shell /usr/sbin/nologin sandbox \
    && install -d -o 1000 -g 1000 -m 0755 /workspace /out

WORKDIR /workspace
USER 1000:1000

# No ENTRYPOINT: the supervisor always supplies the full argv.
CMD ["python", "--version"]
