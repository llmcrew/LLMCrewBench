{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llmcrewbench/schema/profile.schema.json",
  "title": "DailyBench profile manifest v2",
  "description": "Frozen suite version: identifier, slice date and the denominator of every category.",
  "type": "object",
  "required": [
    "schema",
    "profile",
    "total",
    "categories"
  ],
  "properties": {
    "schema": {
      "const": "dailybench/profile/2"
    },
    "profile": {
      "type": "string",
      "minLength": 1
    },
    "frozen": {
      "type": "boolean"
    },
    "slice_date": {
      "type": "string",
      "format": "date"
    },
    "total": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "categories": {
      "type": "object",
      "required": [
        "A",
        "B",
        "C",
        "D",
        "E",
        "F",
        "G",
        "H",
        "I",
        "J",
        "K",
        "L",
        "V"
      ],
      "patternProperties": {
        "^[A-LV]$": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "holdout_seeds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 0
      }
    }
  }
}
