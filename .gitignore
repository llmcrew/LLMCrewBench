# Правила для репозитория бенчмарка.
#
# В git ОБЯЗАНЫ оставаться:
#   suite/<seed>/            — опубликованный сьют и его дайджест
#   configs/reference.json   — политика и эталонные конфигурации
#   vendor/three/            — пришпиленная библиотека визуальных блоков (r186)
#   docs/, tests/, dailybench/, scripts/, Makefile, pyproject.toml
# Видеочасть (ролик, рекордер, клипы) — отдельный репозиторий
# llmcrew/LLMCrewBenchRecoder; сюда её правила не переносятся.
# Игнорируется только то, что воспроизводится прогоном или установкой.
# Исключения (артефакты публикаций) снимаются `!` сразу после правила.

# --- локальные прогоны и артефакты ----------------------------------------- #
# Имя/каталог машины измерения: пути к весам, порты, ключи. Сырые прогоны
# игнорируются, но опубликованные (см. ARTIFACTS.md) — исключения ниже.
# runs/ создаёт `dailybench run|bench|speed|sweep.py`: сами прогоны, отчёты,
# серверные логи (runs/_servers) и sweep-summary.json. Свой out_dir вне runs/
# добавляйте сюда же.
# `/runs/*`, а не `/runs/`: исключённый каталог git не обходит, и `!` внутри
# него не действует.
/runs/*
# Опубликованные прогоны: только отчёт, кадры/страницы витрины и манифесты —
# не транскрипты и не гигантские tasks.json (см. docs/ARTIFACTS.md).
!/runs/deepseek-v4.1-flash-unc-1017/
/runs/deepseek-v4.1-flash-unc-1017/tasks.json
/runs/deepseek-v4.1-flash-unc-1017/transcripts/
/runs/deepseek-v4.1-flash-unc-1017/hardware.json

# Служебные каталоги прогонов и локальные smoke-прогоны — всегда вне git.
/runs/_*/
/runs/smoke-*/
/runs/*-e2e/
/runs/preflight-*.md

# --- окружения ------------------------------------------------------------- #
.venv/
venv/
env/
.conda/

# --- python ---------------------------------------------------------------- #
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
build/
dist/

# --- тесты и покрытие ------------------------------------------------------ #
.pytest_cache/
.tox/
.nox/
.cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# --- линтеры и типы -------------------------------------------------------- #
.mypy_cache/
.dmypy.json
.ruff_cache/
.pytype/

# --- ассеты HTML-отчёта (пересобираются `dailybench report`) ---------------- #
# Плотные копии кадров и библиотек рядом со страницей; включать в git — по
# желанию: `_showcase` весит десятки МБ и полностью воспроизводится.
# runs/_vendor/
# runs/_showcase/

# --- локальные переопределения окружения ------------------------------------ #
# Ключи, endpoint'ы и свои записи конфигураций держите здесь, а не в трекаемых
# файлах: configs/reference.local.json читается через DAILYBENCH_REFERENCE.
configs/*.local.json
configs/reference.local.json
env.local.sh

# --- кэш кадров визуальных блоков ------------------------------------------ #
# По умолчанию кэш лежит в ~/.cache/dailybench/visual; если направить его внутрь
# репозитория через DAILYBENCH_VISUAL_CACHE — не коммитить.
.dailybench-cache/

# --- секреты и локальные настройки ----------------------------------------- #
.env
.env.*
!.env.example
secrets.env

# --- редакторы и ОС -------------------------------------------------------- #
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# --- прочее ---------------------------------------------------------------- #
*.orig
*.rej
*.bak
*.tmp
*.log

# --- Опубликованный отчёт --------------------------------------------------- #
# `dailybench publish` собирает самодостаточный отчёт (страница, графики,
# three.js, копии страниц и кадров) в reports/. Игнорируются все пересборки,
# кроме опубликованных версий (исключения ниже, полный список —
# docs/ARTIFACTS.md); старая выборка остаётся отслеженной как есть.
# `/reports/*`, а не `/reports/` — та же причина, что у runs/.
/reports/*
# Опубликованные артефакты: сравнение deepseek (старый и новый стенд).
!/reports/comparison-deepseek-1017/
# Перепрогон 2026-10-21 двух стендов deepseek: свежие страницы для пересъёмки.
!/reports/comparison-deepseek-1021/
# _vendor опубликованного отчёта остаётся в git: без three.js/plotly страница
# не рисует ни сцену, ни графики, а восстановить их из клона нечем (R18).

# --- агентный рантайм ------------------------------------------------------- #
# pi пишет сюда свой PI_CODING_AGENT_DIR прогона (models.json), а рабочие копии
# задач лежат в системном temp — в git не нужны.
pi-agent/

# --- разбор бандла Orca ----------------------------------------------------- #
# Одиночные чанки app.asar, выгруженные в корень при изучении оркестратора
# (импорты ведут на соседние чанки, которых рядом нет). Живут вне репо.
/*agent-launch*.js
